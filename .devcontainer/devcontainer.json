{
  "name": "Options Pricing & Strategy Analyzer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "main.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo '✅ Packages installed'",
  // Codespaces' port-forwarding proxy breaks Streamlit's CORS/XSRF checks (e.g. for file uploads), so they are
  // disabled here on the command line only - never in .streamlit/config.toml, which also applies to deployments.
  "postAttachCommand": {
    "server": "streamlit run main.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
